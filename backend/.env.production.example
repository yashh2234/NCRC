# Production settings for cPanel (ncrc.namotech.in, PHP 8.3).
# Copy to backend/.env on the server and fill in the blanks, then run:
#   /opt/cpanel/ea-php83/root/usr/bin/php artisan key:generate   (first deploy only)

APP_NAME=NCRC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must be the site root (not /api): upload and scan links are built from it.
APP_URL=https://ncrc.namotech.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
