# reports.namotech.in — public report view only (QR code on approved test reports).
# Only /api/public/* reaches Laravel (through api.php); the rest of the software is not served here.

Options -Indexes -MultiViews
DirectoryIndex index.html

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # The public report API -> Laravel (api.php checks the path again)
    RewriteRule ^api/public/ api.php [L,QSA]

    # Any other API path does not exist on this domain
    RewriteRule ^api(/|$) - [R=404,L]

    # Built assets
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # /r/{token} and / -> the report page
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|svg|png|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "index.html">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
