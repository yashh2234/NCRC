# NCRC — web root rules for cPanel (Apache + PHP 8.3).
#
# Layout on the server (the git checkout *is* the document root):
#   index.html, assets/      React build (copied from frontend/dist by .cpanel.yml)
#   backend/                 Laravel app — never served directly
#   /api/*                   routed to backend/public/index.php
#   /storage/*, uploads      served from backend/public when not in the web root

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass the bearer token through to PHP (Sanctum auth).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block source, config and VCS files. THE_REQUEST is the original request,
    # so the internal rewrites below into backend/public are still allowed.
    RewriteCond %{THE_REQUEST} \s/+(backend|frontend|Old|OfficeDOCS|node_modules|vendor)(/|\s|\?) [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?\.(?!well-known/) [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.(env|yml|yaml|lock|log|sql|sh|ini|bak)(\s|\?) [NC]
    RewriteRule ^ - [R=404,L]

    # API -> Laravel front controller. Laravel sees the full /api/... path,
    # which matches its "api" route prefix.
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]

    # Real files in the web root (Vite assets, favicon) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Public files from Laravel (storage link, scanned copies, etc.).
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f
    RewriteRule ^(.+)$ backend/public/$1 [L]

    # Everything else is a screen in the React app.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "index.html">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
